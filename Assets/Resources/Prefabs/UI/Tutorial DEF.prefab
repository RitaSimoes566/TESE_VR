      propertyPath: m_text
      value: "Podes escolher a velocidade das abelhas, se queres temporizador ou
        se queres ou n\xE3o ver \xE0 tua volta."
      objectReference: {fileID: 0}
    - target: {fileID: 7103513623642254000, guid: c77825570662b474dae2a36bdd46c08f, type: 3}
      propertyPath: m_text
      value: 'Desvia-te dos grupos de borboletas

