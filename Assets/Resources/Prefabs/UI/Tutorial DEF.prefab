    - target: {fileID: 3686274330639475812, guid: c77825570662b474dae2a36bdd46c08f, type: 3}
      propertyPath: m_text
      value: "Lan\xE7a a bola, retirando o dedo do bot\xE3o\ncomo se largasses uma
